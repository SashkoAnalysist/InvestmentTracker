<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.AssetDetailPage"
             Title="Деталі активу">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <!-- Інформація про актив -->
            <Label x:Name="AssetNameLabel" Text="Актив: Ethereum (ETH)" FontSize="22" FontAttributes="Bold" TextColor="#1B365D" />
            <Label x:Name="AssetAmountLabel" Text="Кількість: 1.5 | Баланс: 15 000,00 ₴" FontSize="16" TextColor="#555555" />

            <BoxView HeightRequest="1" Color="#D0D7DE" Margin="0,5" />

            <!-- Блок GPS -->
            <Label Text="Геолокація операції купівлі:" FontAttributes="Bold" FontSize="16" />
            <Label x:Name="LocationStatusLabel" Text="Координати ще не отримано" TextColor="#666666" FontSize="14" />
            <Button Text="Отримати координати (GPS)" 
                    Clicked="OnGetLocationClicked" 
                    BackgroundColor="#0288D1" 
                    TextColor="White" 
                    HeightRequest="42" />

            <BoxView HeightRequest="1" Color="#D0D7DE" Margin="0,5" />

            <!-- Блок Камери -->
            <Label Text="Фотофіксація чека / квитанції:" FontAttributes="Bold" FontSize="16" />
            <Button Text="Зробити фото квитанції (Камера)" 
                    Clicked="OnCapturePhotoClicked" 
                    BackgroundColor="#2E7D32" 
                    TextColor="White" 
                    HeightRequest="42" />

            <Border Stroke="#CCCCCC" StrokeThickness="1" HeightRequest="220" Margin="0,10" BackgroundColor="#FAFAFA">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Image x:Name="ReceiptImageView" Aspect="AspectFit" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>