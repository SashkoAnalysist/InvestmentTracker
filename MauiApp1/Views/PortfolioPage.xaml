<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PortfolioPage"
             Title="Інвестиційний портфель">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15" RowSpacing="10">

        <!-- 1. Панель ролі користувача (RBAC) -->
        <Border Grid.Row="0" Stroke="#1B365D" StrokeThickness="1" BackgroundColor="#F0F4F8" Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" 
                       Text="{Binding CurrentUserInfo}" 
                       FontAttributes="Bold" 
                       TextColor="#1B365D" 
                       VerticalOptions="Center" />
                <Button Grid.Column="1" 
                        Text="Змінити роль (Admin/Viewer)" 
                        Clicked="OnSwitchRoleClicked"
                        BackgroundColor="#1B365D" 
                        TextColor="White" 
                        FontSize="12" 
                        HeightRequest="36" />
            </Grid>
        </Border>

        <!-- 2. Форма швидкого додавання активу -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Entry Placeholder="Назва активу (напр. Bitcoin)" Text="{Binding NewName}" />
            <Entry Placeholder="Тікер (напр. BTC)" Text="{Binding NewSymbol}" />
            <Entry Placeholder="Кількість" Text="{Binding NewAmount}" Keyboard="Numeric" />
            <Entry Placeholder="Поточна ціна ($)" Text="{Binding NewPrice}" Keyboard="Numeric" />
            <Button Text="Додати актив" Command="{Binding AddAssetCommand}" BackgroundColor="#2E7D32" TextColor="White" />
        </VerticalStackLayout>

        <!-- 3. Список активів -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Assets}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="10" Stroke="#D0D7DE" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Symbol}" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding TotalValue, StringFormat='Баланс: {0:C}'}" TextColor="#1B365D" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="Деталі / Фото" 
                                    FontSize="11" 
                                    HeightRequest="36"
                                    Clicked="OnDetailsClicked" 
                                    CommandParameter="{Binding .}" />

                            <Button Grid.Column="2" 
                                    Text="Видалити" 
                                    BackgroundColor="#D32F2F" 
                                    TextColor="White" 
                                    FontSize="11" 
                                    HeightRequest="36"
                                    Clicked="OnDeleteClicked" 
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1B365D" />
    </Grid>
</ContentPage>